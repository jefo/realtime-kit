{
  "name": "@rtkit/udf-datafeed",
  "version": "0.1.0",
  "type": "module",
  "description": "UDF server and provider adapters for TradingView-compatible charts.",
  "license": "MIT",
  "author": "Evgenii Kaizin",
  "homepage": "https://github.com/jefo/realtime-kit/tree/main/packages/udf-datafeed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jefo/realtime-kit.git",
    "directory": "packages/udf-datafeed"
  },
  "bugs": {
    "url": "https://github.com/jefo/realtime-kit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun build src/index.ts --outdir dist --target node --format esm && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "keywords": ["tradingview", "udf", "datafeed", "ohlcv", "binance", "charts"]
}
